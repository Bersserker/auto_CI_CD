{
  "uid": "scoring-drift",
  "title": "Scoring: drift и модели (локальная симуляция)",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Data drift: доля признаков (simulation)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "scoring_data_drift_share",
          "legendFormat": "{{scenario}} {{model}} {{mode}}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 2,
      "title": "Data drift обнаружен (simulation)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "scoring_data_drift_detected",
          "legendFormat": "{{scenario}} {{model}} {{mode}}"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 3,
      "title": "ROC-AUC на зрелых метках (simulation)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "scoring_roc_auc",
          "legendFormat": "{{scenario}} {{model}} {{mode}}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 4,
      "title": "Log loss (simulation)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "scoring_log_loss",
          "legendFormat": "{{scenario}} {{model}} {{mode}}"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 5,
      "title": "Доступность качества (1=yes)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "scoring_quality_available",
          "legendFormat": "{{scenario}} {{model}} {{mode}}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 6,
      "title": "Concept drift: подозрение (simulation)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "scoring_concept_drift_suspected",
          "legendFormat": "{{scenario}} {{model}} {{mode}}"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 7,
      "title": "Трафик A/B и shadow",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (mode,model) (rate(scoring_routed_predictions_total[5m]))",
          "legendFormat": "{{scenario}} {{model}} {{mode}}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 8,
      "title": "Shadow ошибки/пропуски",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "scoring_shadow_errors_total",
          "legendFormat": "{{scenario}} {{model}} {{mode}}"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 9,
      "title": "Shadow delta p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(scoring_shadow_probability_delta_bucket[5m])))",
          "legendFormat": "{{scenario}} {{model}} {{mode}}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 10,
      "title": "Latency Seldon p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le,model) (rate(scoring_seldon_duration_seconds_bucket[5m])))",
          "legendFormat": "{{scenario}} {{model}} {{mode}}"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      }
    }
  ]
}
