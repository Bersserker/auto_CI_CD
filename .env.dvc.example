# Скопируйте в .env после создания аккаунта и бакета артефактов.
# Бакет Terraform state здесь не используется.
DVC_REMOTE_URL=s3://REPLACE_WITH_ARTIFACTS_BUCKET/dvc
DVC_S3_ENDPOINT_URL=https://storage.yandexcloud.net
AWS_DEFAULT_REGION=ru-central1
# Предпочтительно передать ключи в окружение оболочки; в Git их не добавляйте.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
