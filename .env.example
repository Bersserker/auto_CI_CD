# Yandex Cloud: заполните значения, затем из корня проекта:
# set -a; source .env; set +a
# Terraform и Bash-скрипты не загружают .env автоматически.
# Один файл относится к одному окружению. Начните со staging.
CLOUD_ENVIRONMENT=staging

# ID облака/каталога и абсолютный путь к JSON-ключу deploy service account.
# yc CLI для configure-kubectl.sh / verify-cloud.sh настраивается отдельно.
TF_VAR_cloud_id=
TF_VAR_folder_id=
TF_VAR_service_account_key_file=

# Глобально уникальные имена; state и артефакты — разные бакеты.
TF_VAR_state_bucket_name=
TF_VAR_artifacts_bucket_name=
# Выберите доступную версию командой yc managed-kubernetes list-versions.
TF_VAR_kubernetes_version=
TF_VAR_enable_kubernetes=true
TF_VAR_enable_gpu=true
TF_VAR_enable_compute=false
TF_VAR_zone=ru-central1-a

# Приватный API требует VPN/bastion и маршрута в VPC.
# Укажите разрешенный CIDR. Для публичного API: true и свой внешний IP/32.
TF_VAR_kubernetes_public_ip=false
TF_VAR_kubernetes_api_allowed_cidrs='[]'

# S3 backend Terraform: ключи аккаунта с доступом к STATE-бакету.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ru-central1

# Отдельные ключи чтения АРТЕФАКТОВ для Kubernetes Secret s3-credentials.
# Передавайте через временное окружение команды (см. infrastructure/README.txt).
ARTIFACTS_AWS_ACCESS_KEY_ID=
ARTIFACTS_AWS_SECRET_ACCESS_KEY=
DVC_REMOTE_URL=s3://REPLACE_WITH_ARTIFACTS_BUCKET/dvc
DVC_S3_ENDPOINT_URL=https://storage.yandexcloud.net

# Справочные значения для ручных команд; overlay НЕ подставляет их автоматически.
REGISTRY_ID=
RELEASE_TAG=
APP_DOMAIN=
KUBE_CONTEXT=
TLS_CERT_FILE=
TLS_KEY_FILE=
